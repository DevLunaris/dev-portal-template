# Vorlage für docker/.env (docker compose liest diese Datei automatisch).
# ../bootstrap.sh legt docker/.env an, fragt die Domains ab und ersetzt jedes
# __RANDOM__ durch ein eigenes zufälliges Passwort.
# docker/.env enthält Passwörter und gehört NICHT ins Repo.

# Name des Compose-Projekts (Präfix für Container, Images und Volumes)
COMPOSE_PROJECT_NAME=devportal

# Adressen hinter dem Reverse Proxy, ohne https://
#   DEV_DOMAIN:  Dev-Portal (Vorschau, VS Code, phpMyAdmin, Mailpit)
#   PROD_DOMAIN: fertige Website
DEV_DOMAIN=dev.example.com
PROD_DOMAIN=app.example.com

# Ports in der VM, auf die der Reverse Proxy zeigt
PORTAL_PORT=8000
PROD_PORT=8080

# Port, über den der Browser den Vite-HMR-Websocket erreicht.
# Leer = derselbe Port wie die Seite (443 über den Reverse Proxy, PORTAL_PORT im LAN).
HMR_CLIENT_PORT=

# Zeitzone für Container und CodeIgniter
TZ=Europe/Berlin

# Benutzer in der VM, dem die Projektdateien gehören (Ausgabe von id -u / id -g)
DEV_UID=1000
DEV_GID=1000

# git-Konfiguration und Zugangsdaten dieses Benutzers, wird in code-server
# eingebunden, damit git pull/push auch im Terminal von VS Code geht
GIT_CONFIG_DIR=/home/debian/.config/git

# Datenbank (MySQL 8.4)
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=__RANDOM__
DB_ROOT_PASSWORD=__RANDOM__

# Absender für Mails aus CodeIgniter (landen alle in Mailpit)
MAIL_FROM=noreply@app.example.com

# Login für code-server (VS Code im Browser)
CODE_SERVER_PASSWORD=__RANDOM__

# Interner Benutzer "pma" für den phpMyAdmin-Konfigurationsspeicher
PMA_CONTROL_PASSWORD=__RANDOM__
