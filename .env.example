#--------------------------------------------------------------------
# Vorlage für die lokale Entwicklung (ohne Docker), z. B. mit Laragon,
# XAMPP oder "php spark serve".
#
# Kopieren nach .env im Projekt-Root (gehört nicht ins Repo):
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
#
# In der VM wird diese Datei nicht gebraucht, dort kommen die Werte
# aus docker/.env (Vorlage: docker/.env.example).
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

# Adresse, unter der die App im Browser läuft (Vite-Dev-Server)
app.baseURL = 'http://localhost:5173/'

#--------------------------------------------------------------------
# DATENBANK (Standard bei Laragon/XAMPP: root ohne Passwort)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = app
database.default.username = root
database.default.password =
database.default.port = 3306

#--------------------------------------------------------------------
# E-MAIL (SMTP)
#
# Standard: Mail-Falle auf localhost:1025 ohne TLS, z. B. Mailpit
# (https://mailpit.axllent.org, Weboberfläche http://localhost:8025).
# Für einen echten Mailserver Host, Port, Zugangsdaten und
# email.SMTPCrypto = tls bzw. ssl setzen.
#--------------------------------------------------------------------

email.protocol = smtp
email.SMTPHost = localhost
email.SMTPPort = 1025
email.SMTPUser =
email.SMTPPass =
email.SMTPCrypto =
email.fromEmail = noreply@example.com
email.fromName = 'Meine App'
